# ==============================================================================

# ForgeOps

# Git Attributes

# https://git-scm.com/docs/gitattributes

# ==============================================================================

# ==============================================================================

# Default

# ==============================================================================

* text=auto eol=lf

# ==============================================================================

# Source Code

# ==============================================================================

*.java          text diff=java
*.kt            text
*.kts           text
*.groovy        text

*.py            text
*.pyi           text

*.js            text
*.ts            text
*.jsx           text
*.tsx           text

*.html          text
*.css           text
*.scss          text

*.sql           text

*.sh            text eol=lf
*.bash          text eol=lf

*.bat           text eol=crlf
*.cmd           text eol=crlf

# ==============================================================================

# Maven

# ==============================================================================

pom.xml         text

.mvn/**         text

mvnw            text eol=lf

mvnw.cmd        text eol=crlf

# ==============================================================================

# Configuration Files

# ==============================================================================

*.properties    text
*.xml           text
*.json          text
*.yaml          text
*.yml           text
*.toml          text
*.ini           text
*.conf          text

.editorconfig   text
.gitattributes  text
.gitignore      text

# ==============================================================================

# Documentation

# ==============================================================================

*.md            text
*.adoc          text
*.txt           text
*.csv           text

LICENSE         text
NOTICE          text

# ==============================================================================

# Docker

# ==============================================================================

Dockerfile      text
*.dockerfile    text

# ==============================================================================

# Terraform

# ==============================================================================

*.tf            text
*.tfvars        text

# ==============================================================================

# Kubernetes

# ==============================================================================

*.k8s.yaml      text
*.k8s.yml       text

# ==============================================================================

# GitHub

# ==============================================================================

.github/**      text

# ==============================================================================

# Binary Files

# ==============================================================================

*.jar           binary
*.war           binary
*.ear           binary

*.zip           binary
*.gz            binary
*.tar           binary
*.tgz           binary
*.7z            binary
*.rar           binary

*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.svg           text

*.pdf           binary

*.woff          binary
*.woff2         binary
*.ttf           binary
*.otf           binary
*.eot           binary

*.mp3           binary
*.wav           binary
*.ogg           binary

*.mp4           binary
*.avi           binary
*.mov           binary
*.mkv           binary
*.webm          binary

# ==============================================================================

# Diff Drivers

# ==============================================================================

*.java          diff=java
*.xml           diff=xml
*.json          diff=json
*.md            diff=markdown

# ==============================================================================

# Merge Strategy

# ==============================================================================

package-lock.json     merge=union
*.md                  merge=union

# ==============================================================================

# Linguist (GitHub)

# ==============================================================================

*.md linguist-documentation

docs/** linguist-documentation

assets/** linguist-generated=false

*.svg linguist-generated=false

*.png linguist-generated=false

*.jpg linguist-generated=false

*.jpeg linguist-generated=false

# ==============================================================================

# Generated Files

# ==============================================================================

generated/** linguist-generated=true

target/** linguist-generated=true

coverage/** linguist-generated=true

site/** linguist-generated=true

reports/** linguist-generated=true

# ==============================================================================

# End of File

